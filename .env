# Managed by ./lab use <backends...>. Safe to edit by hand: keep the three
# backend lines in sync (same backends, same order).
SIGNAL_LAB_BACKENDS=victoriametrics,jaeger
COMPOSE_FILE=compose.yaml:plugins/backends/victoriametrics/compose.yaml:plugins/backends/jaeger/compose.yaml
COLLECTOR_CONFIGS=--config=/app/deploy/collector/base.yaml --config=/app/plugins/backends/victoriametrics/collector.yaml --config=/app/plugins/backends/jaeger/collector.yaml
